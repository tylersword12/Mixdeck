{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MixDeck",
  "version": "2.1.0",
  "identifier": "app.mixdeck.desktop",
  "build": {
    "frontendDist": "splash"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "MixDeck",
    "shortDescription": "One playlist across Spotify, SoundCloud and YouTube",
    "longDescription": "MixDeck plays one playlist across Spotify, SoundCloud and YouTube with crossfades, controlled from this PC or any phone on your Wi-Fi.",
    "category": "Music",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav"
        ]
      },
      "rpm": {
        "depends": [
          "gstreamer1-plugins-good"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "android": {
      "minSdkVersion": 26
    }
  }
}
